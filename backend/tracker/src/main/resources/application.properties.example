spring.application.name=tracker

# --- Supabase Database Connection Settings ---
spring.datasource.url=[YOUR LOCAL CONNECTION]
spring.datasource.username=[YOUR USERNAME]
spring.datasource.password=[YOUR PASSWORD]

# --- Hibernate & Driver Configurations ---
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Automatically updates your database schema based on your Java Entity classes
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true